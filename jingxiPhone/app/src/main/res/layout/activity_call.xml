<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_call_gradient">

    <!-- 顶部区域：包含悬浮窗按钮和头像状态 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="80dp"
            android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/ivCallAvatar"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:elevation="8dp"
            android:src="@drawable/ic_launcher_round"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvCallName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="联系人名称"
            android:textSize="28sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="正在呼叫..."
            android:textSize="16sp"
            android:textColor="#B0B0B0" />

        <TextView
            android:id="@+id/tvCallDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="00:00"
            android:textSize="16sp"
            android:textColor="#B0B0B0"
            android:fontFamily="monospace"
            android:visibility="gone" />

        </LinearLayout>

        <!-- 最小化按钮 -->
        <ImageView
            android:id="@+id/ivMinimize"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="16dp"
            android:layout_marginTop="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_call_minimize"
            app:tint="#B0B0B0"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:elevation="10dp" />

    </FrameLayout>

    <!-- 滚动字幕区域 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCallSubtitles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="24dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:layout_marginBottom="20dp" />

    <!-- 底部操作区域 -->
    <LinearLayout
        android:id="@+id/llCallActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="70dp"
        android:paddingTop="20dp">

        <!-- 拒绝接听 / 挂断 -->
        <LinearLayout
            android:id="@+id/btnHangUp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_call_hangup"
                android:background="@drawable/bg_call_btn_glass"
                android:backgroundTint="#FF3B30"
                android:padding="18dp" />

            <TextView
                android:id="@+id/tvHangUpText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="挂断"
                android:textColor="#B0B0B0"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 接听（仅来电且未接通时显示） -->
        <LinearLayout
            android:id="@+id/btnAccept"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_call_hangup"
                android:background="@drawable/bg_call_btn_glass"
                android:backgroundTint="#34C759"
                android:padding="18dp"
                android:rotation="135" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="接听"
                android:textColor="#B0B0B0"
                android:textSize="14sp" />
        </LinearLayout>
        
        <!-- 免提/听筒切换（接通后显示） -->
        <LinearLayout
            android:id="@+id/btnSpeaker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivSpeakerIcon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_handset"
                android:background="@drawable/bg_call_btn_glass"
                android:backgroundTint="#888888"
                android:padding="18dp" />

            <TextView
                android:id="@+id/tvSpeakerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="听筒"
                android:textColor="#B0B0B0"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 麦克风开关（接通后显示） -->
        <LinearLayout
            android:id="@+id/btnSpeak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivSpeakIcon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_call_mic"
                android:background="@drawable/bg_call_btn_glass"
                android:backgroundTint="@color/main_brown"
                android:padding="18dp" />

            <TextView
                android:id="@+id/tvSpeakText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="麦克风已开"
                android:textColor="#B0B0B0"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 接通后的文字交流入口 (可选) -->
    <LinearLayout
        android:id="@+id/llKeyboardInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:visibility="gone">
        
        <EditText
            android:id="@+id/etCallInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="说点什么..."
            android:background="@drawable/bg_edit_text_rounded"
            android:padding="12dp"
            android:textSize="16sp"
            android:imeOptions="actionSend"
            android:inputType="text|textMultiLine"
            android:maxLines="3" />
            
        <Button
            android:id="@+id/btnCallSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="发送"
            android:textColor="@color/white"
            android:backgroundTint="@color/main_brown" />
    </LinearLayout>

</LinearLayout>
