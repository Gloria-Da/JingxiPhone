<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:windowBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="?attr/actionBarTheme" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 启用开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="#0D000000">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="启用时间加权"
                    android:textSize="16sp"
                    android:textColor="?android:textColorPrimary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:text="基于艾宾浩斯遗忘曲线：越久远的记忆越模糊，常回忆的记忆遗忘更慢。"
                android:textSize="12sp"
                android:textColor="?android:textColorSecondary" />

            <!-- 情景记忆衰减速率 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="情景记忆：初始衰减速率 λ"
                android:textSize="14sp"
                android:textColor="?android:textColorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <SeekBar
                    android:id="@+id/seekLambdaBase"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="50" />

                <TextView
                    android:id="@+id/tvLambdaBase"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="0.050 (~14天)"
                    android:textSize="12sp"
                    android:gravity="end" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="从未被回忆的记忆，其半衰期。值越小遗忘越慢。"
                android:textSize="11sp"
                android:textColor="?android:textColorSecondary" />

            <!-- 回忆平坦化因子 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="情景记忆：回忆平坦化 β"
                android:textSize="14sp"
                android:textColor="?android:textColorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <SeekBar
                    android:id="@+id/seekBeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="40"
                    android:progress="10" />

                <TextView
                    android:id="@+id/tvBeta"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="0.50"
                    android:textSize="12sp"
                    android:gravity="end" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="每次回忆让遗忘曲线变平坦的程度。值越大，回忆过的记忆越牢固。"
                android:textSize="11sp"
                android:textColor="?android:textColorSecondary" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="关注事项的自然淡化速度。越久远的挂念越不再占据注意。"
                android:textSize="11sp"
                android:textColor="?android:textColorSecondary" />

            <!-- 衰减下限 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="情景记忆：衰减下限（最低保留）"
                android:textSize="14sp"
                android:textColor="?android:textColorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <SeekBar
                    android:id="@+id/seekRetentionFloor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="50"
                    android:progress="5" />

                <TextView
                    android:id="@+id/tvRetentionFloor"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="0.05"
                    android:textSize="12sp"
                    android:gravity="end" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="记忆不会完全消失，至少保留此比例。"
                android:textSize="11sp"
                android:textColor="?android:textColorSecondary" />

            <!-- 预览 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="效果预览"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary" />

            <TextView
                android:id="@+id/tvPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="#0D000000"
                android:text="示例：重要度3的记忆\n从未回忆，14天后权重 = 1.5\n回忆3次，14天后权重 = 2.3\n回忆10次，100天后权重 = 1.3"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"
                android:textColor="?android:textColorSecondary" />

            <!-- 保存按钮 -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="保存设置"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
