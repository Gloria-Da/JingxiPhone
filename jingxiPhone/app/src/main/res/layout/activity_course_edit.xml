<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="课程名称"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorTextPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="8dp" android:hint="老师" app:hintTextColor="?attr/colorPrimary">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTeacher" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="?attr/colorTextPrimary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="教室" app:hintTextColor="?attr/colorPrimary">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLocation" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="?attr/colorTextPrimary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="星期" android:textSize="13sp"
            android:textColor="?attr/colorTextSecondary" />
        <Spinner android:id="@+id/spinnerDay"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="?attr/colorCardBackground" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="12dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="开始节次" android:textSize="13sp" android:textColor="?attr/colorTextSecondary" />
                <NumberPicker android:id="@+id/npStartPeriod"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="连上节数" android:textSize="13sp" android:textColor="?attr/colorTextSecondary" />
                <NumberPicker android:id="@+id/npPeriodCount"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="周次模式" android:textSize="13sp"
            android:textColor="?attr/colorTextSecondary" />

        <RadioGroup android:id="@+id/rgWeekPattern"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp">
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbEvery" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="每周" android:textColor="?attr/colorTextPrimary"
                android:checked="true" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbOdd" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="单周" android:textColor="?attr/colorTextPrimary" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbEven" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="双周" android:textColor="?attr/colorTextPrimary" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbCustom" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="自定义" android:textColor="?attr/colorTextPrimary" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCustomWeeks"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:hint="指定周次（如 1,3-5,8）"
            app:hintTextColor="?attr/colorPrimary" android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomWeeks" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="?attr/colorTextPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="颜色" android:textSize="13sp"
            android:textColor="?attr/colorTextSecondary" />
        <LinearLayout android:id="@+id/colorPicker"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp"
            android:gravity="center" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:hint="备注（可选）"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotes" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="?attr/colorTextPrimary"
                android:inputType="textMultiLine" android:minLines="2" android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="24dp">
            <Button android:id="@+id/btnDelete" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="8dp" android:text="删除"
                android:textColor="@android:color/holo_red_dark"
                style="?attr/materialButtonOutlinedStyle" android:visibility="gone" />
            <Button android:id="@+id/btnSave" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="保存" style="?attr/materialButtonStyle" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
