<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_shared_content_card">

    <TextView
        android:id="@+id/tvErrorIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="⚠️"
        android:textSize="36sp" />

    <TextView
        android:id="@+id/tvErrorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="AI请求失败"
        android:textColor="#D32F2F"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/llErrorDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#FFF3E0">

        <TextView
            android:id="@+id/tvHttpCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E65100"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvApiError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BF360C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvErrorHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="请检查API设置中的配置是否正确"
            android:textColor="#888888"
            android:textSize="12sp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnDismiss"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="知道了"
        android:textColor="@android:color/white"
        android:backgroundTint="#D32F2F" />

</LinearLayout>
